# PostgreSQL connection string used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lenny_growth_assistant
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Application settings.
APP_NAME=Lenny Growth Assistant
APP_ENV=development

# LLM provider settings.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local text and Markdown documents used for keyword retrieval.
KNOWLEDGE_BASE_PATH=knowledge
